# Server listen settings (Coolify sets PORT or routes to 3000 by default)
HOST=0.0.0.0
PORT=3000

# Public URL when behind a reverse proxy (recommended in Coolify, e.g. https://vndb.example.com)
# ORIGIN=https://vndb.example.com

# Reverse proxy header forwarding (defaults are already set in Dockerfile)
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Path to the built SQLite database
VNDB_DB_PATH=/app/data/vndb.sqlite

# Optional: download a prebuilt database (.sqlite, .sqlite.zst, or .sqlite.gz) on first boot
# if VNDB_DB_PATH does not already exist (e.g. a GitHub Release asset URL)
# VNDB_DB_URL=https://github.com/<owner>/<repo>/releases/download/db-2026-11-23/vndb.sqlite.zst

# Optional: set to 1 to automatically download & parse the latest VNDB dump on first boot
# when VNDB_DB_PATH is missing (takes ~1–2 minutes; prefer BUILD_DB=1 or VNDB_DB_URL in Coolify)
# AUTO_BUILD_DB=0
