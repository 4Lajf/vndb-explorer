{
  "name": "vndb-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:build": "node --experimental-strip-types scripts/build-db.ts",
    "db:refresh": "node --experimental-strip-types scripts/refresh-dump.ts && node --experimental-strip-types scripts/build-db.ts",
    "db:refresh:clean": "node --experimental-strip-types scripts/refresh-dump.ts && node --experimental-strip-types scripts/build-db.ts --clean"
  },
  "dependencies": {
    "@lucide/svelte": "^1.78.0",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
